# ============================================================
# AI Lesson Studio - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control.

# ------------------------------------------------------------
# LLM Provider: "groq" (FREE) or "openai"
# ------------------------------------------------------------
LLM_PROVIDER=groq

# ------------------------------------------------------------
# Groq Configuration (Free at https://console.groq.com)
# ------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# Recommended Groq Models:
# - llama-3.3-70b-versatile (Recommended, high quality)
# - llama-3.1-8b-instant (Fastest)
GENERATOR_MODEL=llama-3.3-70b-versatile
EVALUATOR_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------
# OpenAI Configuration (Optional alternative)
# ------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
# GENERATOR_MODEL=gpt-4o
# EVALUATOR_MODEL=gpt-4o

# ------------------------------------------------------------
# Generation Settings
# ------------------------------------------------------------
GENERATOR_TEMPERATURE=0.7
EVALUATOR_TEMPERATURE=0.1
MAX_RETRIES=2

# ------------------------------------------------------------
# Application & Database
# ------------------------------------------------------------
APP_NAME=AI Lesson Studio
APP_ENV=development
DATABASE_PATH=data/lesson_generator.db
OUTPUT_DIR=outputs
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Mock Mode (set to true to test without any API calls)
# ------------------------------------------------------------
MOCK_MODE=false
